{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RemoteMe": {
    "Guacd": {
      "Host": "127.0.0.1",
      "Port": 4822,
      "ConnectTimeoutSeconds": 15
    },
    "Rdp": {
      "Hostname": "rds01.contoso.local",
      "Port": 3389,
      "Security": "nla",
      "IgnoreCertificate": false,
      "Domain": "",
      "LoadBalanceInfo": "",
      "ServerLayout": "fr-fr-azerty",
      "ClientName": "RemoteMe",
      "ResizeMethod": "display-update",
      "EnableAudio": true,
      "EnableAudioInput": false,
      "EnablePrinting": false,
      "EnableClipboardCopy": true,
      "EnableClipboardPaste": true,
      "EnableDrive": false,
      "ExtraParameters": {}
    },
    "Environments": {
      "UsernamePattern": "kiosk{0:00}",
      "PatternStart": 1,
      "PatternCount": 0,
      "SharedPassword": "",
      "Domain": "",
      "Accounts": [],
      "IdleTimeoutMinutes": 15,
      "MaxLifetimeMinutes": 240,
      "CooldownSeconds": 90,
      "MaxConnectionsPerEnvironment": 3,
      "MaxEnvironmentsPerIp": 3,
      "MaxNewEnvironmentsPerIpPerHour": 20,
      "ResetCommand": "",
      "ResetArguments": [],
      "ResetTimeoutSeconds": 120
    },
    "KnownProxies": []
  }
}
