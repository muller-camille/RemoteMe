<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- Hébergement in-process : un seul processus, donc un seul pool d'environnements en mémoire. -->
      <aspNetCore processPath="dotnet" arguments=".\RemoteMe.Web.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <!-- Nécessite la fonctionnalité IIS « Protocole WebSocket » (Web-WebSockets). -->
      <webSocket enabled="true" />
      <security>
        <requestFiltering removeServerHeader="true">
          <!-- appsettings*.json et apps.json ne doivent jamais être servis. -->
          <hiddenSegments>
            <add segment="appsettings.json" />
            <add segment="appsettings.Production.json" />
            <add segment="apps.json" />
          </hiddenSegments>
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
